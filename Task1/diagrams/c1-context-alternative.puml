@startuml
!include C4_Context.puml
    title Контекстная диаграмма (C1) - Альтернативное решение: распределенная архитектура


' Пользователи
Person(agronomist, "Агроном", "Работает в поле")
Person(mechanic, "Механик", "Мониторит технику")
Person(director, "Директор хозяйства", "Управляет хозяйством")
Person(analyst, "Аналитик", "Анализирует эффективность")

' Тепличный комплекс
System_Boundary(greenhouse_site, "Тепличный комплекс (площадка)") {
    System(greenhouse_local, "Локальная система теплицы", "SCADA, локальное хранилище, локальная аналитика, управление климатом")
}

' Полевой участок
System_Boundary(field_site, "Полевой участок (площадка)") {
    System(field_local, "Локальная система поля", "IoT-шлюз, локальное хранилище, мониторинг техники, локальная аналитика")
}

' Центральная система (головной офис)
System_Boundary(hq, "Головной офис") {
    System(hq_aggregator, "Агрегатор данных", "Сбор данных со всех площадок, глобальная аналитика")
    System(hq_apps, "Центральные приложения", "Веб-портал, ERP-интеграция, глобальные отчеты")
}

' Внешние системы
System_Ext(erp, "ERP (LC Агро)", "Финансы, склад, кадры")
System_Ext(bi, "Power BI", "Глобальная визуализация")
System_Ext(sensors, "Датчики и техника", "Тепличные датчики, метеостанции, GPS-трекеры")

' Связи: Пользователи → Системы
Rel(agronomist, field_local, "Мобильное приложение", "Полевые отчеты")
Rel(mechanic, field_local, "Локальный веб-интерфейс", "Мониторинг техники")
Rel(director, hq_apps, "Веб-портал", "Управление хозяйством")
Rel(analyst, bi, "Анализ данных", "Отчеты")

' Связи: Площадки ↔ Датчики
Rel(sensors, greenhouse_local, "Данные с датчиков", "LoRaWAN, Modbus")
Rel(sensors, field_local, "Данные с датчиков", "LoRaWAN, 4G, GPS")

' Связи: Площадки → Центр
Rel(greenhouse_local, hq_aggregator, "Синхронизация агрегированных данных", "HTTPS, периодическая")
Rel(field_local, hq_aggregator, "Синхронизация агрегированных данных", "HTTPS, периодическая")

' Связи в центре
Rel(hq_aggregator, hq_apps, "Глобальные данные", "Внутренний API")
Rel(hq_aggregator, bi, "Отчеты", "ODBC")
Rel(hq_apps, erp, "Синхронизация", "REST API")

@enduml