@startuml alernative Farm
!include C4_Context.puml

title Контекстная диаграмма (C1) - Альтернативное решение: Централизованная архитектура

Person(worker, "Дежурный на ферме", "Не имеет гарантированного локального оповещения при обрыве связи")
Person(vet, "Ветеринар / Оператор", "Мониторит алерты через веб-интерфейс")
Person(manager, "Руководитель хозяйства", "Управляет хозяйством")

System_Boundary(farm, "Свиноводческая ферма") {
    System(thin_gateway, "'Тонкий' шлюз на ферме", "Только захват и ретрансляция видеопотока")
    System_Ext(cameras, "IP-камеры", "Видеопоток")
    System_Ext(feeders, "Контроллеры кормушек и поилок", "Управление только через облако")
}

System_Boundary(hq, "Головной офис (Облако)") {
    System(cloud_service, "Центральные сервисы платформы", "Видеоаналитика, управление, хранение, оповещения")
}

System_Ext(erp, "ERP (LC Агро)", "Финансы, склад")
System_Ext(ml_partner, "Партнер по ML", "Обновление моделей (только в облаке)")

' --- Связи ---
Rel(worker, thin_gateway, "⚠️ Нет гарантированного локального оповещения", "При обрыве связи")
Rel(vet, cloud_service, "Просматривает алерты", "Веб-портал")
Rel(manager, cloud_service, "Анализирует отчеты", "Веб-портал")

Rel(cameras, thin_gateway, "Видеопоток", "LAN")
Rel(thin_gateway, feeders, "⚠️ Задержка команд", "Из-за необходимости обхода через облако")

Rel(thin_gateway, cloud_service, "НЕПРЕРЫВНАЯ передача тяжелых видеопотоков", "WiFi/4G (высокий риск обрыва)")
Rel(cloud_service, erp, "Передача бизнес-метрик", "REST API")
Rel(ml_partner, cloud_service, "Обновление моделей", "Только в облаке")

note as RejectedNote
  ❌ ПРИЧИНА ОТКЛОНЕНИЯ (Компромиссы и риски):
  
  1. Нарушение NFR (< 5 сек): При нестабильном WiFi на ферме 
     передача видеопотока в облако и возврат команды создадут 
     недопустимые задержки.
  2. Риск простоя: При обрыве интернета ферма становится 
     "слепой", дежурный не получит сигнал о задавливании поросят.
  3. Высокая стоимость трафика: Постоянная передача HD-видео 
     в головной офис экономически неэффективна.
end note

' Скрытые связи для правильного позиционирования note на диаграмме
Rel(RejectedNote, thin_gateway, "", "hidden")
Rel(RejectedNote, cloud_service, "", "hidden")

SHOW_LEGEND()
@enduml