@startuml c1_farm_hybrid_simple
!include C4_Context.puml

title Контекстная диаграмма (C1) - Гибридная архитектура (упрощенная)

' --- Пользователи ---
Person(worker, "Дежурный на ферме", "Получает локальные оповещения и контролирует ситуацию на месте")
Person(vet, "Ветеринар / Оператор", "Мониторит алерты и состояние поголовья через веб-интерфейс")
Person(manager, "Руководитель хозяйства", "Управляет хозяйством и анализирует сводные отчеты")
Person(mobile_worker, "Мобильный оператор", "Получает push-уведомления и просматривает статус через мобильное приложение")

' --- Системы ---
System_Boundary(farm, "Свиноводческая ферма") {
    System(edge_agent, "Edge-Агент", "Сбор телеметрии с датчиков, управление кормушками, передача данных в облако")
    System_Ext(cameras, "IP-камеры", "Видеопоток (RTSP)")
    System_Ext(feeders, "Кормушки и поилки", "Управление через Modbus и MQTT")
    System_Ext(sensors, "Датчики", "Фильтрация и контроль корма")
}

System_Boundary(hq, "Облачная платформа") {
    System(cloud_service, "Облачные сервисы", "API Gateway, видеоаналитика с нейросетями, бизнес-сервисы, брокер сообщений, базы данных")
}

' --- Внешние системы ---
System_Ext(erp, "Внешние системы", "ERP и BI системы")

' --- Связи ---
' Локальные связи на ферме
Rel(worker, edge_agent, "Получает локальное оповещение", "Звук и свет")
Rel(cameras, edge_agent, "Видеопоток", "RTSP")
Rel(sensors, edge_agent, "Телеметрия датчиков", "MQTT")
Rel(feeders, edge_agent, "Телеметрия и управление", "Modbus и MQTT")
Rel(edge_agent, feeders, "Команды управления", "Modbus и MQTT")

' Связи с облаком
Rel(edge_agent, cloud_service, "Асинхронная передача событий и метрик", "MQTT и WebSocket")
Rel(cloud_service, edge_agent, "Доставка команд и обновлений", "MQTT и WebSocket")

' Пользователи и облако
Rel(vet, cloud_service, "Просматривает алерты и управляет фермой", "HTTPS")
Rel(manager, cloud_service, "Анализирует сводные отчеты", "HTTPS")
Rel(mobile_worker, cloud_service, "Получает push-уведомления и просматривает статус", "HTTPS и Push")

' Внешние системы
Rel(cloud_service, erp, "Передача данных и отчетов", "REST API")

note right of cloud_service
  КЛЮЧЕВЫЕ ОСОБЕННОСТИ:
  * Гибридная архитектура
  * Edge-агент для сбора данных и локального управления
  * Видеоаналитика в облаке на PyTorch и TensorRT
  * RabbitMQ или Redis для асинхронной коммуникации
  * PostgreSQL для данных ферм
  * MinIO или S3 для хранения видео
end note

SHOW_LEGEND()
@enduml