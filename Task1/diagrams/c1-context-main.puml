@startuml main Farm
!include C4_Context.puml

title Контекстная диаграмма (C1) - Основное решение: Гибридная архитектура (Edge-агент)

Person(worker, "Дежурный на ферме", "Получает локальные оповещения и контролирует ситуацию на месте")
Person(vet, "Ветеринар / Оператор", "Мониторит алерты и состояние поголовья через веб-интерфейс")
Person(manager, "Руководитель хозяйства", "Управляет хозяйством и анализирует сводные отчеты")

System_Boundary(farm, "Свиноводческая ферма (Edge-контур)") {
    System(edge_agent, "Интеллектуальный Edge-агент", "Локальная видеоаналитика, управление периферией, офлайн-оповещение (< 5 сек)")
    System_Ext(cameras, "IP-камеры", "Видеопоток (в т.ч. ночной режим)")
    System_Ext(feeders, "Контроллеры кормушек и поилок", "Разные производители")
}

System_Boundary(hq, "Головной офис (Облако)") {
    System(cloud_service, "Центральные сервисы платформы", "Прием событий, API, дашборды, долгосрочное хранение")
}

System_Ext(erp, "ERP (LC Агро)", "Финансы, склад, общее поголовье")
System_Ext(ml_partner, "Партнер по ML", "Предоставляет обновления моделей нейросетей")

' --- Связи ---
Rel(worker, edge_agent, "Получает локальное оповещение", "Звук/Свет, < 5 сек, без интернета")
Rel(vet, cloud_service, "Просматривает алерты и видеофрагменты", "Веб-портал")
Rel(manager, cloud_service, "Анализирует сводные отчеты", "Веб-портал")

Rel(cameras, edge_agent, "Видеопоток", "LAN")
Rel(edge_agent, feeders, "Сигналы управления", "При тревоге или по расписанию")

Rel(edge_agent, cloud_service, "Асинхронная передача событий и метрик", "При наличии связи (допустима задержка)")
Rel(cloud_service, erp, "Передача агрегированных бизнес-метрик", "REST API")
Rel(ml_partner, cloud_service, "Загрузка новых версий моделей", "Для последующей доставки на агенты")

note right of edge_agent
  КЛЮЧЕВОЕ ОТЛИЧИЕ ДЛЯ БИЗНЕСА:
  Вся критическая логика (аналитика, 
  реакция < 5 сек) находится на ферме.
  Головной офис не участвует в 
  контуре мгновенного реагирования.
end note

SHOW_LEGEND()
@enduml