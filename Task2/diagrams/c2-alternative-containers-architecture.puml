@startuml
!include C4_Container.puml
!include C4_Context.puml


title Диаграмма контейнеров (C2) - Решение 2: Распределенная архитектура с полноценным Edge

' ============================================================
' ОБЛАКО (ЦЕНТРАЛЬНЫЙ СЕРВЕР)
' ============================================================
System_Boundary(cloud_dist, "Облачная инфраструктура (Центральный сервер)") {
    
    Container(api_gw_dist, "API Gateway", "Traefik", "**Функции:** OAuth2/OIDC, Rate Limiting, Circuit Breaker, Service Discovery")
    
    Container(auth_dist, "Сервис Авторизации", "Keycloak", "**Функции:** RBAC, MFA, Audit Logging<br>**Протоколы:** OAuth2, OIDC, SAML")
    
    Container(kafka_dist, "Kafka Cluster", "Apache Kafka", "**Особенности:** Хранение 30 дней, Replication Factor: 3<br>**Темы:** herd.*, feeding.*, health.*, water.*, video.*")
    
    Container(herd_svc, "Сервис Поголовья", "Kotlin + Spring Boot", "**Bounded Context:** Стадо<br>**События:** herd.born, herd.died, herd.moved")
    
    Container(feed_svc, "Сервис Кормления", "Kotlin + Spring Boot", "**Bounded Context:** Кормление<br>**События:** feeding.consumed, feeding.refilled")
    
    Container(health_svc, "Сервис Здоровья", "Python + FastAPI", "**Bounded Context:** Ветеринария<br>**События:** health.symptom, health.disease")
    
    Container(notif_svc, "Сервис Оповещений", "Node.js + NestJS", "**Bounded Context:** Уведомления<br>**Функции:** Push, Email, SMS, WebSocket")
    
    Container(analytics_dist, "Аналитический Сервис", "Python + Spark", "**Bounded Context:** Аналитика<br>**Функции:** ETL, BI выгрузки, ML модели")
    
    ContainerDb(postgres_herd, "Herd DB", "PostgreSQL", "Животные, перемещения")
    ContainerDb(postgres_feed, "Feed DB", "PostgreSQL", "Запасы кормов")
    ContainerDb(clickhouse_dist, "ClickHouse", "ClickHouse", "Все события, телеметрия")
    ContainerDb(minio_dist, "Data Lake", "MinIO (S3)", "Видеозаписи, снимки")
    Container(cache_dist, "Кэш", "Redis Cluster", "Сессии, частые запросы")
}

' ============================================================
' EDGE (ФЕРМА) - ПОЛНОЦЕННЫЙ
' ============================================================
System_Boundary(edge_dist, "Локальная ферма (Полноценный Edge)") {
    
    Container(mqtt_edge, "MQTT Broker", "EMQX", "**Особенности:** 100k+ устройств, QoS 0/1/2, Мост в Kafka")
    
    Container(edge_sync, "Edge Sync Agent", "Rust", "**Функции:** Буферизация, Сжатие, Retry политика, Dead Letter Queue")
    
    Container(video_analytics_edge, "Видео-Аналитик", "Python + TensorRT", "**Особенности:** Оптимизация для NVIDIA Jetson<br>**Функции:** Захват RTSP, Инференс, Детекция событий")
    
    Container(feeding_ctrl, "Контроллер Кормления", "C++ / Go", "**Функции:** Управление кормушками, Сбор телеметрии<br>**Протоколы:** Modbus TCP, MQTT")
    
    Container(local_api, "Локальный API", "Python FastAPI", "**Функции:** REST API, gRPC, Автономная работа")
    
    ContainerDb(edge_tsdb, "TimescaleDB Edge", "TimescaleDB", "**Данные:** События (2 недели), Телеметрия<br>**Особенности:** Автономный режим")
    
    Container(edge_web, "Локальный Веб-Интерфейс", "React + Vite", "**Особенности:** PWA, Офлайн-режим (Service Worker)<br>**Функции:** Мониторинг, Управление")
}

' ============================================================
' ВНЕШНИЕ СИСТЕМЫ
' ============================================================
System_Ext(cameras_dist, "IP-Камеры", "H.264/H.265 RTSP")
System_Ext(feeders_dist, "Кормушки", "Modbus TCP, MQTT")
System_Ext(erp_dist, "ERP (LC Агро)", "REST API")
System_Ext(bi_dist, "Power BI", "ODBC/JDBC")

Person(operator_dist, "Оператор фермы", "Управляет фермой")
Person(vet_dist, "Ветеринар", "Мониторит здоровье животных")

' ============================================================
' СВЯЗИ: ВНУТРИ EDGE
' ============================================================
Rel(cameras_dist, video_analytics_edge, "RTSP поток", "Ethernet")
Rel(video_analytics_edge, mqtt_edge, "Публикует события", "MQTT")
Rel(video_analytics_edge, edge_tsdb, "Сохраняет метаданные", "SQL")
Rel(video_analytics_edge, operator_dist, "Локальное уведомление", "WebSocket")

Rel(mqtt_edge, feeding_ctrl, "Подписка: cmd.feeding.*", "MQTT")
Rel(mqtt_edge, edge_sync, "Подписка: все события", "MQTT")

Rel(feeding_ctrl, feeders_dist, "Управление", "Modbus/MQTT")
Rel(feeding_ctrl, mqtt_edge, "Публикует телеметрию", "MQTT")

Rel(edge_sync, edge_tsdb, "Сохраняет события", "SQL")
Rel(edge_sync, local_api, "Предоставляет данные", "gRPC")
Rel(local_api, edge_web, "API запросы", "HTTPS")
Rel(edge_web, operator_dist, "Интерфейс управления", "HTTPS + WebSocket")
Rel(edge_web, vet_dist, "Интерфейс ветеринара", "HTTPS + WebSocket")

' ============================================================
' СВЯЗИ: EDGE → CLOUD
' ============================================================
Rel(edge_sync, kafka_dist, "Публикация событий<br>Пакетная отправка<br>Retry: 3 попытки", "Kafka Protocol (SSL/TLS)")

' ============================================================
' СВЯЗИ: ВНУТРИ CLOUD
' ============================================================
Rel(kafka_dist, herd_svc, "Потребление: animal.*", "Kafka Consumer")
Rel(kafka_dist, feed_svc, "Потребление: feeding.*", "Kafka Consumer")
Rel(kafka_dist, health_svc, "Потребление: health.*", "Kafka Consumer")
Rel(kafka_dist, notif_svc, "Потребление: event.*", "Kafka Consumer")
Rel(kafka_dist, analytics_dist, "Потребление: все темы", "Kafka Consumer")

Rel(api_gw_dist, auth_dist, "Валидация токенов", "OAuth2")
Rel(api_gw_dist, herd_svc, "REST API", "HTTP/HTTPS")
Rel(api_gw_dist, feed_svc, "REST API", "HTTP/HTTPS")
Rel(api_gw_dist, health_svc, "REST API", "HTTP/HTTPS")
Rel(api_gw_dist, notif_svc, "REST API", "HTTP/HTTPS")
Rel(api_gw_dist, analytics_dist, "REST API", "HTTP/HTTPS")

Rel(operator_dist, api_gw_dist, "Мобильное/Веб-приложение", "HTTPS + WebSocket")
Rel(vet_dist, api_gw_dist, "Веб-приложение ветеринара", "HTTPS")

' ============================================================
' ВНЕШНИЕ ИНТЕГРАЦИИ
' ============================================================
Rel(herd_svc, erp_dist, "Синхронизация: поголовье", "REST API")
Rel(feed_svc, erp_dist, "Обновление: складские остатки", "REST API")
Rel(analytics_dist, bi_dist, "Экспорт: данные", "ODBC/JDBC")

@enduml